    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst filePath = (body.filePath || '').trim();\nconst collection = (body.collection || 'ship_manuals_v3').trim();\nconst folder = (body.folder || '').trim();\n\nif (!filePath) throw new Error('filePath zorunlu! Örnek: { \"filePath\": \"C:\\\\Users\\\\usyyt\\\\.n8n-files\\\\M-67 INCINERATOR.pdf\", \"collection\": \"ship_manuals_v3\", \"folder\": \"MACHINERY\" }');\n\n// Windows ve Linux path'lerini handle et\nconst parts = filePath.replace(/\\\\/g, '/').split('/');\nconst filename = parts[parts.length - 1] || 'unknown.pdf';\n\nreturn [{ json: { filePath, filename, collection, folder } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Parse Webhook"
    },
    {
      "parameters": {
        "fileSelector": "={{ $json.filePath }}",
        "options": {}
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [440, 0],
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Read PDF"
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [660, 0],
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Extract PDF Text"
    },
    {
      "parameters": {
        "jsCode": "// Sayfa-bilinçli chunking: sayfa numarası ve dosya adını metadata'ya kaydeder\n// Bu sayede sorgularda 'Kaynak: X.pdf Sayfa: Y' alıntıları çalışır\n\nconst text = $input.first().json.text || '';\nconst params = $items('Parse Webhook')[0].json;\nconst filename = params.filename || 'unknown.pdf';\nconst folder = params.folder || '';\n\n// PDF form-feed karakteri (\\f = 0x0C) sayfa sınırlarını gösterir\nconst rawPages = text.split('\\f');\nconst hasRealPages = rawPages.length > 2;\n\nconst CHUNK_SIZE = 1500;   // karakter - semantik arama için optimal\nconst OVERLAP = 150;       // overlap - context kaybetmemek için\nconst CHARS_PER_PAGE = 3000; // form-feed yoksa sayfa tahmini\n\nconst results = [];\n\nif (hasRealPages) {\n  // GERÇEK SAYFA NUMARALARI (form-feed'ler var)\n  rawPages.forEach((pageText, pageIdx) => {\n    const trimmed = pageText.trim();\n    if (trimmed.length < 50) return; // boş/çok kısa sayfaları atla\n\n    if (trimmed.length <= CHUNK_SIZE) {\n      results.push({\n        json: {\n          pageContent: trimmed,\n          metadata: {\n            source: filename,\n            page: pageIdx + 1,\n            chunk: 0,\n            folder: folder\n          }\n        }\n      });\n    } else {\n      // Büyük sayfaları overlap'li parçalara böl\n      let chunkIdx = 0;\n      for (let i = 0; i < trimmed.length; i += (CHUNK_SIZE - OVERLAP)) {\n        const chunk = trimmed.substring(i, i + CHUNK_SIZE).trim();\n        if (chunk.length < 50) continue;\n        results.push({\n          json: {\n            pageContent: chunk,\n            metadata: {\n              source: filename,\n              page: pageIdx + 1,\n              chunk: chunkIdx,\n              folder: folder\n            }\n          }\n        });\n        chunkIdx++;\n      }\n    }\n  });\n} else {\n  // TAHMİNİ SAYFA NUMARALARI (form-feed yok, char sayısına göre tahmin)\n  let chunkIdx = 0;\n  for (let i = 0; i < text.length; i += (CHUNK_SIZE - OVERLAP)) {\n    const chunk = text.substring(i, i + CHUNK_SIZE).trim();\n    if (chunk.length < 50) continue;\n    const estimatedPage = Math.floor(i / CHARS_PER_PAGE) + 1;\n    results.push({\n      json: {\n        pageContent: chunk,\n        metadata: {\n          source: filename,\n          page: estimatedPage,\n          chunk: chunkIdx,\n          folder: folder\n        }\n      }\n    });\n    chunkIdx++;\n  }\n}\n\nreturn results;"
      },
