
# n8n dış URL ve webhooks
N8N_HOST=argusbot.duckdns.org
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://argusbot.duckdns.org
WEBHOOK_URL=https://argusbot.duckdns.org/

# n8n API (Claude'un workflow oluşturması için)
N8N_API_URL=https://argusbot.duckdns.org
N8N_API_KEY=<N8N_API_KEY>

# Claude / OpenAI
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
OPENAI_API_KEY=<OPENAI_API_KEY>

# Telegram
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>

# Gmail / Google OAuth
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_SHEETS_API_KEY=<GOOGLE_SHEETS_API_KEY>

# YouTube, Twilio, diğer servisler
YOUTUBE_API_KEY=<YOUTUBE_API_KEY>
TWILIO_ACCOUNT_SID=<TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<TWILIO_AUTH_TOKEN>
TWILIO_PHONE_NUMBER=<TWILIO_PHONE_NUMBER>
ALERT_TARGET_NUMBER=<ALERT_TARGET_NUMBER>
VAPI_API_KEY=<VAPI_API_KEY>
KIA_API_KEY=<KIA_API_KEY>

# Binance
BINANCE_API_KEY=<BINANCE_API_KEY>
BINANCE_API_SECRET=<BINANCE_API_SECRET>

# Crypto news
CRYPTO_NEWS_API_KEY=<CRYPTO_NEWS_API_KEY>
CRYPTOPANIC_API_KEY=<CRYPTOPANIC_API_KEY>

# Twilio voice endpoint
VOICE_API_URL="https://api.twilio.com/2010-04-01/Accounts/${TWILIO_ACCOUNT_SID}/Calls.json"
VOICE_API_KEY=<TWILIO_BASIC_AUTH_BASE64>
